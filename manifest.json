{
  "id": "./",
  "name": "Group Hangout",
  "short_name": "Hangout",
  "description": "Meet up, chat, call and plan with your people. Private messages, groups, voice and video calls, and meetings.",
  "lang": "en",
  "dir": "auto",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090a",
  "theme_color": "#09090a",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/chats-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Your chats, groups and friends in one place" },
    { "src": "screenshots/chat-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Messages with sent, delivered and read ticks" },
    { "src": "screenshots/launch-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Smooth launch screen" },
    { "src": "screenshots/desktop-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Chats and conversation side by side" }
  ],
  "shortcuts": [
    { "name": "Chats", "short_name": "Chats", "description": "Open your chats", "url": "./?tab=chats", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Groups", "short_name": "Groups", "description": "Open your groups", "url": "./?tab=groups", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Meetings", "short_name": "Meetings", "description": "Start or join a meeting", "url": "./?tab=meet", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Find friends", "short_name": "Find", "description": "Find and add friends", "url": "./?tab=find", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "text/plain": [".txt"] },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+grouphangout", "url": "./?join=%s" }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 400 },
  "scope_extensions": [
    { "type": "origin", "origin": "https://group-24984.firebaseapp.com" }
  ],
  "tab_strip": {
    "home_tab": "auto",
    "new_tab_button": { "url": "./" }
  },
  "note_taking": { "new_note_url": "./?tab=chats" },
  "widgets": [
    {
      "name": "Group Hangout",
      "short_name": "Hangout",
      "description": "Jump straight back into your chats.",
      "tag": "hangout-quick",
      "ms_ac_template": "widgets/template.json",
      "data": "widgets/data.json",
      "type": "application/json",
      "screenshots": [
        { "src": "widgets/screenshot.png", "sizes": "387x387", "label": "Quick chat widget" }
      ],
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }],
      "auth": false
    }
  ],
  "related_applications": [
    { "platform": "play", "id": "com.grouphangout.app" }
  ],
  "prefer_related_applications": false,
  "iarc_rating_id": "00000000-0000-0000-0000-000000000000"
}
